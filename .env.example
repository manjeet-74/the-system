# ---- Frontend (safe to expose; these are bundled into the site) ----
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your project's public anon key>
# Public VAPID key for web push (generate a pair: npx web-push generate-vapid-keys)
VITE_VAPID_PUBLIC_KEY=

# ---- Edge Function secrets: NOT used by the frontend ----
# Set these with `supabase secrets set NAME=value`; never put them in Vercel or commit them.
#   GEMINI_API_KEY        free key from https://aistudio.google.com/ (AI grading + daily message)
#   CRON_SECRET           any long random string (openssl rand -hex 32); also goes in cron.local.sql
#   VAPID_PUBLIC_KEY      same public key as above
#   VAPID_PRIVATE_KEY     the private half of the pair
#   VAPID_SUBJECT         a contact URL, e.g. https://github.com/<you>/the-system
#   RESEND_API_KEY        optional, for email reminders
#   RESEND_FROM           optional, e.g. "THE SYSTEM <noreply@yourdomain.com>" (needs a verified domain)
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected into functions automatically.
